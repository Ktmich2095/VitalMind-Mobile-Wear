# Servidor
NODE_ENV=development
PORT=4000
API_PREFIX=/api

# Base de datos MySQL (usa exactamente vitalmind ya existente)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=vitalmind
DB_CONNECTION_LIMIT=10

# JWT
JWT_ACCESS_SECRET=cambia_este_secreto_de_acceso
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=cambia_este_secreto_de_refresh
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Microservicio de Machine Learning (contrato POST /api/v1/analyze)
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=8000
